import os
import sqlite3
import json
import requests

AQI_API_KEY = os.getenv("AQI_API_KEY")
if not AQI_API_KEY:
    raise ValueError("Missing AQI_API_KEY environment variable")


def read_data_from_file(city_name):
    params = {
        "apikey": AQI_API_KEY,
        "q": city_name
    }
    response = requests.get("https://hub.juheapi.com/aqi/v1/city", params=params)

    if response.status_code == 200:
        return response.json()

    print(f"Error: {response.status_code}")
    return None


def set_up_database(db_name):
    conn = None
    try:
        conn = sqlite3.connect("data/database.db")
        cursor = conn.cursor()


        cursor.execute(
            "CREATE TABLE IF NOT EXISTS aqi_data (city TEXT UNIQUE, aqi INTEGER)"
        )
        conn.commit()
    except sqlite3.Error as e:
        print(f"Error creating database or table: {e}")
        return None, None

    return cursor, conn


def set_up_aqi_table(data, cursor, conn):
    try:
        if not data or "data" not in data or not data["data"]:
            print("API did not return usable data")
            return

        result = data["data"]
        city = result.get("city")
        aqi = result.get("aqi")

        if aqi is not None:
            aqi = int(aqi)

        cursor.execute(
        "INSERT OR REPLACE INTO aqi_data (city, aqi) VALUES (?, ?)",
    (city, aqi)
    )
     
        conn.commit()
        print("Inserted:", city, aqi)

    except Exception as e:
        print("Error inserting data:", e)


def load_processed_cities():
    if os.path.exists("processed_cities.json"):
        with open("processed_cities.json", "r") as f:
            try:
                return set(json.load(f))
            except json.JSONDecodeError:
                return set()
    return set()


def save_processed_cities(processed_cities):
    with open("processed_cities.json", "w") as f:
        json.dump(list(processed_cities), f)


def get_cities_to_process(all_cities):
    processed = load_processed_cities()
    unprocessed_cities = [city for city in all_cities if city not in processed]
    cities_for_this_run = unprocessed_cities[:25]
    return cities_for_this_run


def calc_avg_aqi(city_list, cursor, conn):
    aqi_total = 0
    city_count = 0
    successfully_processed_cities = set()

    for city_name in city_list:
        data = read_data_from_file(city_name)

        try:
            set_up_aqi_table(data, cursor, conn)

            if (
                data
                and "data" in data
                and data["data"]
                and data["data"].get("aqi") is not None
            ):
                successfully_processed_cities.add(city_name)

                aqi_value = data["data"]["aqi"]
                aqi_total += int(aqi_value)
                city_count += 1

        except Exception:
            pass

    print("Cities processed in this run:", city_count)

    if city_count > 0:
        avg_aqi = aqi_total / city_count
    else:
        avg_aqi = 0

    return avg_aqi, successfully_processed_cities


